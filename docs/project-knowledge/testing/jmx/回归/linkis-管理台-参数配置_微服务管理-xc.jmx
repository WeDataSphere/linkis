            <stringProp name="filename"></stringProp>
            <stringProp name="script">${__setProperty(bdp-user-ticket-id,${bdp-user-ticket-id},)};</stringProp>
          </BeanShellPostProcessor>
          <hashTree/>
        </hashTree>
