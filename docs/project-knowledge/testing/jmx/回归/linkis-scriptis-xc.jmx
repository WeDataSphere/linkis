          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 后置处理程序--校验xlsx文件里存在截取相关关键字" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.jmeter.samplers.SampleResult
import org.apache.jmeter.assertions.AssertionResult
import java.io.*
import org.apache.poi.xssf.usermodel.XSSFWorkbook
import org.apache.poi.ss.usermodel.*
import org.apache.poi.ss.usermodel.*
import org.apache.xmlbeans.*
import java.io.ByteArrayInputStream
import java.io.FileInputStream
import org.apache.commons.io.FileUtils

// 原始响应数据获取
def response = prev.getResponseData()
if (response == null || response.length == 0) {
    SampleResult.setStopTestNow(true)
    throw new Exception(&quot;响应数据为空，无法生成文件&quot;)
}
// 1. 保存二进制流为xlsx文件（原有逻辑）
def filePath = &quot;D:/大数据/自动化/功能测试/WEMETER2024/result_dowload/result.xlsx&quot; // 修改为实际路径
def outputFile = new File(filePath)
FileUtils.writeByteArrayToFile(outputFile, response)
// 2. 新增校验逻辑
def keyword = &quot;结果集存在字段值超过32,767字符，无法全量下载，以下字段截取前32,767字符展示：string501&quot;
def found = false
try (FileInputStream fis = new FileInputStream(outputFile);
     Workbook workbook = new XSSFWorkbook(fis)) {
    
    (0..&lt;workbook.numberOfSheets).each { index -&gt;
      def sheet = workbook.getSheetAt(index)
        for (Row row : sheet) {
            for (Cell cell : row) {
                // 统一处理单元格值为字符串格式
                String cellValue = &quot;&quot;
                switch (cell.getCellType()) {
                    case CellType.STRING:
                        cellValue = cell.getStringCellValue()
                        break
                    case CellType.NUMERIC:
                        cellValue = String.valueOf(cell.getNumericCellValue())
                        break
                    case CellType.BOOLEAN:
                        cellValue = String.valueOf(cell.getBooleanCellValue())
                        break
                    case CellType.FORMULA:
                        cellValue = cell.getCellFormula()
                        break
                    default:
                        cellValue = &quot;&quot;
                }
                
                // 校验关键字
                if (cellValue.contains(keyword)) {
                    found = true
                    return true // 退出循环
                }
            }
            if (found) break // 行循环退出
        }
        if (found) return true // Sheet循环退出
    }
} catch (Exception e) {
    log.error(&quot;文件校验失败: &quot; + e.getMessage())
    SampleResult.setStopTest(true)
    throw e
}
// 3. 结果处理
//if (found) {
//    log.info(&quot;文件校验成功：检测到关键字&quot;)
//    vars.put(&quot;FILE_VALIDATION_RESULT&quot;, &quot;PASS&quot;)
//} else {
//    log.error(&quot;文件校验失败：未检测到关键字&quot;)
//    vars.put(&quot;FILE_VALIDATION_RESULT&quot;, &quot;FAIL&quot;)
//    // 可选：失败时删除无效文件
//    // outputFile.delete() 
//}
if (found) {
   log.info(&quot;✅ 文件校验成功&quot;)
   vars.put(&quot;FILE_VALIDATION_RESULT&quot;, &quot;PASS&quot;)
} else {
   String errorMsg = &quot;❌ 文件校验失败：未检测到关键字&quot;
   
   // 直接设置SampleResult状态
   prev.setSuccessful(false)  // 标记请求失败
   prev.setResponseMessage(errorMsg)  // 设置错误消息
   prev.setResponseData(errorMsg, &quot;UTF-8&quot;)  // 设置响应内容
   
   // 记录日志和变量
   log.error(errorMsg)
   vars.put(&quot;FILE_VALIDATION_RESULT&quot;, &quot;FAIL&quot;)
}
</stringProp>
