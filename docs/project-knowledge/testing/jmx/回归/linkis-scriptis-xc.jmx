            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.io.*;
// 1. 检查响应数据是否为空
byte[] result = prev.getResponseData();
if (result == null || result.length == 0) {
    log.error(&quot;下载内容为空！请检查接口响应&quot;);
    return; // 终止执行
}
// 2. 动态文件名（避免覆盖）
String timestamp = System.currentTimeMillis().toString();
String dynamicFileName = &quot;WEMETER2024_&quot; + timestamp + &quot;.bin&quot;; // 扩展名按需修改
// 3. 自动创建目录（路径使用正斜杠兼容多系统）
String baseDir = &quot;D:/大数据/自动化/功能测试/WEMETER2024/&quot;;
File dir = new File(baseDir);
if (!dir.exists()) {
    dir.mkdirs(); // 创建多级目录
}
// 4. 写入文件（添加异常捕获）
File file = new File(dir, dynamicFileName);
try (FileOutputStream out = new FileOutputStream(file)) {
    out.write(result);
    log.info(&quot;文件保存成功: &quot; + file.getAbsolutePath());
} catch (IOException e) {
    log.error(&quot;写入文件失败: &quot;, e);
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 后置处理程序" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.jmeter.samplers.SampleResult;
import java.io.*;
// 获取上一个采样器的响应数据（二进制流）
SampleResult prevResult = prev;
byte[] excelData = prevResult.getResponseData();
// 校验数据有效性
if (excelData == null || excelData.length == 0) {
    log.error(&quot;下载内容为空！请检查接口是否返回数据&quot;);
    return;
}
// 动态生成带时间戳的文件名（避免覆盖）
String timestamp = new Date().format(&quot;yyyyMMddHHmmss&quot;);
String fileName = &quot;WEMETER_download_many_excel_mask_&quot; + timestamp + &quot;.xlsx&quot;; // 强制指定.xlsx扩展名
// 设置保存路径（改用正斜杠兼容所有系统）
String savePath = &quot;D:/大数据/自动化/功能测试/WEMETER2024/result_dowload/&quot; + fileName;
// 确保目录存在
File directory = new File(&quot;D:/大数据/自动化/功能测试/WEMETER2024/result_dowload/&quot;);
if (!directory.exists()) {
    directory.mkdirs(); // 创建多级目录
}
// 写入文件（关键：使用原生二进制写入）
try (FileOutputStream fos = new FileOutputStream(savePath)) {
    fos.write(excelData);
    log.info(&quot;Excel文件保存成功: &quot; + savePath);
} catch (IOException e) {
    log.error(&quot;文件写入失败: &quot;, e);
    throw e; // 抛出异常使测试标记为失败
}
// 额外验证：检查文件头确认是Excel文件
if (excelData.length &gt; 8) {
    String fileHeader = new String(Arrays.copyOfRange(excelData, 0, 8), &quot;ISO-8859-1&quot;);
    if (!fileHeader.equals(&quot;PK\u0003\u0004&quot;)) { // Excel的魔术字节
        log.warn(&quot;警告：文件头不符合Excel格式，实际头: &quot; + fileHeader);
    }
}</stringProp>
          </JSR223PostProcessor>
