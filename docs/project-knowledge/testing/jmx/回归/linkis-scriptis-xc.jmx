        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 后置处理程序--校验xlsx文件里正确屏蔽敏感字段" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.jmeter.samplers.SampleResult
import java.io.*
import org.apache.poi.xssf.usermodel.XSSFWorkbook
import org.apache.poi.ss.usermodel.*
import org.apache.commons.io.FileUtils
// 配置区域 - 可修改参数
def outputDir = &quot;D:/大数据/自动化/功能测试/WEMETER2024/result_dowload&quot;
def fileName = &quot;result_mask_manysheets.xlsx&quot;
def filePath = &quot;${outputDir}/${fileName}&quot;
// 创建输出目录
new File(outputDir).mkdirs()
// 1. 保存二进制流为xlsx文件
def response = prev.getResponseData()
if (response == null || response.length == 0) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;响应数据为空，无法生成文件&quot;)
    throw new Exception(&quot;响应数据为空，无法生成文件&quot;)
}
def outputFile = new File(filePath)
FileUtils.writeByteArrayToFile(outputFile, response)
log.info(&quot;文件已保存至: ${filePath}&quot;)
// 2. 多Sheet校验配置
// 2.1 必须存在的关键字
def requiredSheetKeywords = [
    &quot;resultset0&quot;: [&quot;string_val&quot;,&quot;varchar_val&quot;,&quot;int_val&quot;],
    &quot;resultset1&quot;: [&quot;col_5&quot;,&quot;col_9998&quot;],
    &quot;resultset2&quot;: [&quot;string_val&quot;,&quot;a&quot;,&quot;id&quot;]
]
// 2.2 新增：必须不存在的关键字
def absentSheetKeywords = [
    &quot;resultset0&quot;: [&quot;float_val&quot;],
    &quot;resultset1&quot;: [&quot;col_9999&quot;, &quot;col_10001&quot;, &quot;col_10000&quot;]
]
// 3. 执行校验
def requiredResults = [:]  // 存在校验结果
def absentResults = [:]    // 不存在校验结果
def allFound = true
try (FileInputStream fis = new FileInputStream(outputFile);
     Workbook workbook = new XSSFWorkbook(fis)) {
    
    // 3.1 校验必须存在关键字
    requiredSheetKeywords.each { sheetName, keywords -&gt;
        def result = [found: [], missing: [], details: []]
        Sheet sheet = workbook.getSheet(sheetName)
        
        if (!sheet) {
            keywords.each { keyword -&gt;
                result.missing &lt;&lt; keyword
                result.details &lt;&lt; &quot;❌ Sheet不存在导致关键字 &apos;${keyword}&apos; 缺失&quot;
            }
            allFound = false
        } else {
            keywords.each { keyword -&gt;
                def (found, location) = findKeywordInSheet(sheet, keyword)
                if (found) {
                    result.found &lt;&lt; keyword
                    result.details &lt;&lt; &quot;✅ 找到关键字 &apos;${keyword}&apos; (${location})&quot;
                } else {
                    result.missing &lt;&lt; keyword
                    result.details &lt;&lt; &quot;❌ 未找到关键字 &apos;${keyword}&apos;&quot;
                    allFound = false
                }
            }
        }
        requiredResults[sheetName] = result
    }
    
    // 3.2 校验必须不存在关键字
    absentSheetKeywords.each { sheetName, keywords -&gt;
        def result = [found: [], absent: [], details: []]
        Sheet sheet = workbook.getSheet(sheetName)
        
        if (!sheet) {
            result.details &lt;&lt; &quot;⚠️ Sheet不存在，跳过不存在校验&quot;
        } else {
            keywords.each { keyword -&gt;
                def (found, location) = findKeywordInSheet(sheet, keyword)
                if (found) {
                    result.found &lt;&lt; keyword
                    result.details &lt;&lt; &quot;❌ 禁止关键字 &apos;${keyword}&apos; 被找到 (${location})&quot;
                    allFound = false
                } else {
                    result.absent &lt;&lt; keyword
                    result.details &lt;&lt; &quot;✅ 关键字 &apos;${keyword}&apos; 未出现（符合要求）&quot;
                }
            }
        }
        absentResults[sheetName] = result
    }
    
} catch (Exception e) {
    log.error(&quot;文件校验失败: &quot; + e.getMessage(), e)
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;文件校验异常: ${e.getMessage()}&quot;)
    throw e
}
// 4. 生成校验报告
def report = new StringBuilder(&quot;📊 Excel文件双模式校验报告\n&quot;)
report.append(&quot;文件路径: ${filePath}\n\n&quot;)
// 4.1 存在校验报告
report.append(&quot;===== 存在关键字校验 =====\n&quot;)
if (requiredResults) {
    requiredResults.each { sheetName, result -&gt;
        report.append(&quot;▸ Sheet: ${sheetName}\n&quot;)
        if (result.missing) {
            report.append(&quot;  缺失: ${result.missing.join(&apos;, &apos;)}\n&quot;)
        }
        result.details.each { report.append(&quot;  ${it}\n&quot;) }
        report.append(&quot;\n&quot;)
    }
} else {
    report.append(&quot;未配置存在关键字校验\n&quot;)
}
// 4.2 不存在校验报告
report.append(&quot;===== 不存在关键字校验 =====\n&quot;)
if (absentResults) {
    absentResults.each { sheetName, result -&gt;
        report.append(&quot;▸ Sheet: ${sheetName}\n&quot;)
        if (result.found) {
            report.append(&quot;  违规出现: ${result.found.join(&apos;, &apos;)}\n&quot;)
        }
        result.details.each { report.append(&quot;  ${it}\n&quot;) }
        report.append(&quot;\n&quot;)
    }
} else {
    report.append(&quot;未配置不存在关键字校验\n&quot;)
}
// 5. 结果处理
if (allFound) {
    def successMsg = &quot;✅ 所有关键字校验通过&quot;
    log.info(successMsg)
    report.insert(0, &quot;[SUCCESS] ${successMsg}\n\n&quot;)
    vars.put(&quot;FILE_VALIDATION_RESULT&quot;, &quot;PASS&quot;)
    prev.setResponseData(report.toString(), &quot;UTF-8&quot;)
} else {
    def errorMsg = &quot;❌ 文件校验失败&quot;
    log.error(errorMsg)
    report.insert(0, &quot;[FAILURE] ${errorMsg}\n\n&quot;)
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;文件校验失败&quot;)
    prev.setResponseData(report.toString(), &quot;UTF-8&quot;)
    vars.put(&quot;FILE_VALIDATION_RESULT&quot;, &quot;FAIL&quot;)
}
// 存储详细报告
vars.put(&quot;VALIDATION_REPORT&quot;, report.toString())
// 辅助函数：在Sheet中查找关键字（返回[是否找到, 位置描述]）
def findKeywordInSheet(Sheet sheet, String keyword) {
    for (Row row : sheet) {
        for (Cell cell : row) {
            String cellValue = getCellValueAsString(cell)
            if (cellValue.contains(keyword)) {
                def location = &quot;行${row.getRowNum() + 1}列${cell.getColumnIndex() + 1}&quot;
                return [true, location]
            }
        }
    }
    return [false, &quot;&quot;]
}
// 辅助函数：获取单元格值
String getCellValueAsString(Cell cell) {
    if (cell == null) return &quot;&quot;
    switch (cell.getCellType()) {
        case CellType.STRING:
            return cell.getStringCellValue().trim()
        case CellType.NUMERIC:
            return String.valueOf(cell.getNumericCellValue())
        case CellType.BOOLEAN:
            return String.valueOf(cell.getBooleanCellValue())
        case CellType.FORMULA:
            return cell.getCellFormula()
        default:
            return &quot;&quot;
    }
}</stringProp>
          </JSR223PostProcessor>
