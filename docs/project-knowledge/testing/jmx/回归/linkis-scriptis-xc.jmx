          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 后置处理程序--校验xlsx文件里存在敏感字段" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.jmeter.samplers.SampleResult
import java.io.*
import org.apache.poi.xssf.usermodel.XSSFWorkbook
import org.apache.poi.ss.usermodel.*
import org.apache.commons.io.FileUtils
// 配置区域 - 可修改参数
def outputDir = &quot;D:/大数据/自动化/功能测试/WEMETER2024/result_dowload&quot;
//def fileName = &quot;result_${new Date().format(&apos;yyyyMMdd_HHmmss&apos;)}.xlsx&quot;
def fileName = &quot;result_nomask_manysheets.xlsx&quot;
def filePath = &quot;${outputDir}/${fileName}&quot;
// 创建输出目录
new File(outputDir).mkdirs()
// 1. 保存二进制流为xlsx文件
def response = prev.getResponseData()
if (response == null || response.length == 0) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;响应数据为空，无法生成文件&quot;)
    throw new Exception(&quot;响应数据为空，无法生成文件&quot;)
}
def outputFile = new File(filePath)
FileUtils.writeByteArrayToFile(outputFile, response)
log.info(&quot;文件已保存至: ${filePath}&quot;)
// 2. 多Sheet多关键字校验配置
def sheetKeywords = [
    // 格式: [sheet名称: [关键字1, 关键字2, ...]]
    &quot;resultset0&quot;: [&quot;string_val&quot;, &quot;varchar_val&quot;, &quot;char_val&quot;],
    &quot;resultset1&quot;: [&quot;col_4&quot;, &quot;col_3&quot;, &quot;col_2&quot;, &quot;col_9999&quot;, &quot;col_10001&quot;, &quot;col_10000&quot;, &quot;col_1&quot;],
    &quot;resultset2&quot;: [&quot;string_val&quot;, &quot;col_1&quot;],
    &quot;resultset3&quot;: [&quot;enterprise_name&quot;, &quot;organization_code&quot;, &quot;taxpayer_identification_number&quot;, &quot;unified_credit_code&quot;],
    &quot;resultset4&quot;: [&quot;enterprise_name&quot;, &quot;organization_code&quot;, &quot;taxpayer_identification_number&quot;, &quot;unified_credit_code&quot;],
    &quot;resultset5&quot;: [&quot;group&quot;, &quot;select&quot;, &quot;100cpu_usage_pct90&quot;, &apos;currency$usd&apos;, &quot;data_date&quot;, &quot;id no&quot;, &quot;timestamp&quot;, &quot;user_name&quot;],
    &quot;resultset6&quot;: [&quot;100cpu_usage_pct90&quot;, &apos;currency$usd&apos;, &quot;data_date&quot;, &quot;group&quot;, &quot;id no&quot;, &quot;select&quot;, &quot;timestamp&quot;, &quot;user_name&quot;]
]
// 3. 执行多Sheet多关键字校验
def validationResults = [:]
def allFound = true
try (FileInputStream fis = new FileInputStream(outputFile);
     Workbook workbook = new XSSFWorkbook(fis)) {
    
    // 遍历配置的sheet和关键字
    sheetKeywords.each { sheetName, keywords -&gt;
        def sheetResult = [
            sheetName: sheetName,
            keywords: keywords,
            foundKeywords: [],
            missingKeywords: [],
            details: []
        ]
        
        Sheet sheet = workbook.getSheet(sheetName)
        if (!sheet) {
            sheetResult.missingKeywords = keywords
            sheetResult.details &lt;&lt; &quot;Sheet页不存在&quot;
            allFound = false
            validationResults[sheetName] = sheetResult
            return // 跳过当前sheet
        }
        
        // 检查每个关键字
        keywords.each { keyword -&gt;
            def keywordFound = false
            def foundLocation = &quot;&quot;
            
            // 遍历sheet内容
            rowLoop: for (Row row : sheet) {
                for (Cell cell : row) {
                    String cellValue = getCellValueAsString(cell)
                    if (cellValue.contains(keyword)) {
                        keywordFound = true
                        foundLocation = &quot;第${row.getRowNum()+1}行, 第${cell.getColumnIndex()+1}列&quot;
                        break rowLoop
                    }
                }
            }
            
            if (keywordFound) {
                sheetResult.foundKeywords &lt;&lt; keyword
                sheetResult.details &lt;&lt; &quot;找到关键字 &apos;${keyword}&apos; (位置: ${foundLocation})&quot;
            } else {
                sheetResult.missingKeywords &lt;&lt; keyword
                sheetResult.details &lt;&lt; &quot;未找到关键字 &apos;${keyword}&apos;&quot;
                allFound = false
            }
        }
        
        validationResults[sheetName] = sheetResult
    }
    
} catch (Exception e) {
    log.error(&quot;文件校验失败: &quot; + e.getMessage(), e)
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;文件校验异常: ${e.getMessage()}&quot;)
    throw e
}
// 4. 生成校验报告
def report = new StringBuilder(&quot;📊 Excel文件校验报告\n&quot;)
report.append(&quot;文件路径: ${filePath}\n\n&quot;)
validationResults.each { sheetName, result -&gt;
    report.append(&quot;=== Sheet: ${sheetName} ===\n&quot;)
    if (result.missingKeywords) {
        report.append(&quot;❌ 缺失关键字: ${result.missingKeywords.join(&apos;, &apos;)}\n&quot;)
    }
    if (result.foundKeywords) {
        report.append(&quot;✅ 找到关键字: ${result.foundKeywords.join(&apos;, &apos;)}\n&quot;)
    }
    report.append(&quot;详细结果:\n&quot;)
    result.details.each { detail -&gt; report.append(&quot; - ${detail}\n&quot;) }
    report.append(&quot;\n&quot;)
}
// 5. 结果处理
if (allFound) {
    def successMsg = &quot;✅ 所有关键字校验通过&quot;
    log.info(successMsg)
    report.insert(0, &quot;[SUCCESS] ${successMsg}\n\n&quot;)
    
    vars.put(&quot;FILE_VALIDATION_RESULT&quot;, &quot;PASS&quot;)
    prev.setResponseData(report.toString(), &quot;UTF-8&quot;)
} else {
    def errorMsg = &quot;❌ 文件校验失败：部分关键字缺失&quot;
    log.error(errorMsg)
    report.insert(0, &quot;[FAILURE] ${errorMsg}\n\n&quot;)
    
    // 设置失败状态
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;文件校验失败&quot;)
    prev.setResponseData(report.toString(), &quot;UTF-8&quot;)
    
    // 记录变量
    vars.put(&quot;FILE_VALIDATION_RESULT&quot;, &quot;FAIL&quot;)
    
//    // 可选：删除无效文件
//    try {
//        if (outputFile.exists()) {
//            outputFile.delete()
//            log.warn(&quot;已删除无效文件: ${outputFile.name}&quot;)
//        }
//    } catch (Exception e) {
//        log.error(&quot;文件删除失败&quot;, e)
//    }
}
// 存储详细报告到变量
vars.put(&quot;VALIDATION_REPORT&quot;, report.toString())
// 辅助函数：获取单元格值
String getCellValueAsString(Cell cell) {
    if (cell == null) return &quot;&quot;
    
    switch (cell.getCellType()) {
        case CellType.STRING:
            return cell.getStringCellValue()
        case CellType.NUMERIC:
            return String.valueOf(cell.getNumericCellValue())
        case CellType.BOOLEAN:
            return String.valueOf(cell.getBooleanCellValue())
        case CellType.FORMULA:
            return cell.getCellFormula()
        default:
            return &quot;&quot;
    }
}</stringProp>
          </JSR223PostProcessor>
