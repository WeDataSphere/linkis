        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="scriptis--spark关联表个数超过5个检测[code-precheck]--UNION ALL单个查询中关联表个数&gt;5，不检测！！！" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="code" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">SELECT d_year       ,i_brand_id       ,i_class_id       ,i_category_id       ,i_manufact_id       ,SUM(sales_cnt) AS sales_cnt       ,SUM(sales_amt) AS sales_amt FROM (SELECT d_year             ,i_brand_id             ,i_class_id             ,i_category_id             ,i_manufact_id             ,cs_quantity - COALESCE(cr_return_quantity,0) AS sales_cnt             ,cs_ext_sales_price - COALESCE(cr_return_amount,0.0) AS sales_amt       FROM trino_db_text.catalog_sales                           JOIN trino_db_text.item ON i_item_sk=cs_item_sk                          JOIN trino_db_text.date_dim ON d_date_sk=cs_sold_date_sk                          JOIN trino_db_text.warehouse ON cs_sold_date_sk = w_warehouse_sk                          JOIN trino_db_text.web_page ON cs_sold_date_sk = wp_web_page_sk                          JOIN trino_db_text.web_site ON cs_sold_date_sk = web_site_sk                          LEFT JOIN trino_db_text.catalog_returns ON (cs_order_number=cr_order_number                                                     AND cs_item_sk=cr_item_sk)       WHERE i_category=&apos;Sports&apos;       UNION ALL       SELECT d_year             ,i_brand_id             ,i_class_id             ,i_category_id             ,i_manufact_id             ,ss_quantity - COALESCE(sr_return_quantity,0) AS sales_cnt             ,ss_ext_sales_price - COALESCE(sr_return_amt,0.0) AS sales_amt       FROM trino_db_text.store_sales JOIN trino_db_text.item ON i_item_sk=ss_item_sk                        JOIN trino_db_text.date_dim ON d_date_sk=ss_sold_date_sk                        LEFT JOIN trino_db_text.store_returns ON (ss_ticket_number=sr_ticket_number                                                 AND ss_item_sk=sr_item_sk)       WHERE i_category=&apos;Sports&apos;       UNION ALL       SELECT d_year             ,i_brand_id             ,i_class_id             ,i_category_id             ,i_manufact_id             ,ws_quantity - COALESCE(wr_return_quantity,0) AS sales_cnt             ,ws_ext_sales_price - COALESCE(wr_return_amt,0.0) AS sales_amt       FROM trino_db_text.web_sales JOIN trino_db_text.item ON i_item_sk=ws_item_sk                      JOIN trino_db_text.date_dim ON d_date_sk=ws_sold_date_sk                      LEFT JOIN trino_db_text.web_returns ON (ws_order_number=wr_order_number                                             AND ws_item_sk=wr_item_sk)       WHERE i_category=&apos;Sports&apos;) sales_detail GROUP BY d_year, i_brand_id, i_class_id, i_category_id, i_manufact_id;</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
