 		then ws_net_paid_inc_tax * ws_quantity else 0 end) as aug_net  	from           trino_db_text.web_sales          ,trino_db_text.warehouse          ,trino_db_text.date_dim          ,trino_db_text.time_dim  	  ,trino_db_text.ship_mode      where             web_sales.ws_warehouse_sk =  warehouse.w_warehouse_sk         and web_sales.ws_sold_date_sk = date_dim.d_date_sk         and web_sales.ws_sold_time_sk = time_dim.t_time_sk  	and web_sales.ws_ship_mode_sk = ship_mode.sm_ship_mode_sk         and d_year = 2002  	and t_time between 49530 and 49530+28800   	and sm_carrier in (&apos;DIAMOND&apos;,&apos;AIRBORNE&apos;)      group by          w_warehouse_name  	,w_warehouse_sq_ft  	,w_city  	,w_county  	,w_state  	,w_country     ,d_year;</stringProp>
