                <stringProp name="Argument.value">select avg(ss_list_price) B1_LP             ,count(ss_list_price) B0_CNT             ,count(distinct ss_list_price) B1_CNTD             ,count(distinct ss_list_price) B2_CNTD             ,count(distinct ss_list_price) B3_CNTD             ,count(distinct ss_list_price) B4_CNTD             ,count(distinct ss_list_price) B5_CNTD             ,count(distinct ss_list_price) B6_CNTD             ,count(distinct ss_list_price) B7_CNTD             ,count(distinct ss_list_price) B8_CNTD             ,count(distinct ss_list_price) B9_CNTD             ,count(distinct ss_list_price) B10_CNTD             ,count(distinct ss_list_price) B11_CNTD             ,count(distinct ss_list_price) B12_CNTD             ,count(distinct ss_list_price) B13_CNTD             ,count(distinct ss_list_price) B14_CNTD             ,count(distinct ss_list_price) B15_CNTD             ,count(distinct ss_list_price) B16_CNTD             ,count(distinct ss_list_price) B17_CNTD             ,count(distinct ss_list_price) B18_CNTD             ,count(distinct ss_list_price) B19_CNTD       from trino_db_text.store_sales       where ss_quantity in (select ss_quantity from trino_db_text.store_sales group by ss_quantity HAVING COUNT(DISTINCT ss_quantity) between 0 and 5);</stringProp>
