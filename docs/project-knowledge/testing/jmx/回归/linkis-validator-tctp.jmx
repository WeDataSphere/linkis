                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">with my_customers as (  select  c_customer_sk         , c_current_addr_sk  from            ( select cs_sold_date_sk sold_date_sk,                  cs_bill_customer_sk customer_sk,                  cs_item_sk item_sk           from   trino_db_text.catalog_sales           union all           select ws_sold_date_sk sold_date_sk,                  ws_bill_customer_sk customer_sk,                  ws_item_sk item_sk           from   trino_db_text.web_sales          ) cs_or_ws_sales,          trino_db_text.item,          trino_db_text.date_dim,          trino_db_text.customer  where   sold_date_sk = d_date_sk          and item_sk = i_item_sk          and i_category = &apos;Jewelry&apos;          and i_class = &apos;football&apos;          and c_customer_sk = cs_or_ws_sales.customer_sk          and d_moy = 3          and d_year = 2000          group by  c_customer_sk         , c_current_addr_sk  )  , my_revenue as (  select c_customer_sk,         sum(ss_ext_sales_price) as revenue  from   my_customers,         trino_db_text.store_sales,         trino_db_text.customer_address,         trino_db_text.store,         trino_db_text.date_dim  where  c_current_addr_sk = ca_address_sk         and ca_county = s_county         and ca_state = s_state         and ss_sold_date_sk = d_date_sk         and c_customer_sk = ss_customer_sk         and d_month_seq between (1203)                            and  (1205)  group by c_customer_sk  )  , segments as  (select cast((revenue/50) as int) as segment   from   my_revenue  ),test as  (select segment as segment1   from   segments  )   select  segment1, count(*) as num_customers, segment1*50 as segment_base  from test  group by segment1  order by segment1, num_customers  limit 100;</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">code</stringProp>
