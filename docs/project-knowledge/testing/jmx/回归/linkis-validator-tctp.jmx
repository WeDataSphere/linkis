        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="scriptis--hive case when超过20检测[code-precheck]--单层子级=20，提示" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="code" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">select  *  from(select w_warehouse_name             ,i_item_id             ,sum(case when (cast(d_date as date) &lt; cast (&apos;1998-04-08&apos; as date)) 	                then inv_quantity_on_hand                        else 1 end) as inv_before             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-08&apos; as date))                       then inv_quantity_on_hand                        else 2 end) as inv_after             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-09&apos; as date))                       then inv_quantity_on_hand                        else 3 end) as inv_after3             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-10&apos; as date))                       then inv_quantity_on_hand                        else 4 end) as inv_after4             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-11&apos; as date))                       then inv_quantity_on_hand                        else 5 end) as inv_after5             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-12&apos; as date))                       then inv_quantity_on_hand                        else 6 end) as inv_after6             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-13&apos; as date))                       then inv_quantity_on_hand                        else 7 end) as inv_after7             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-14&apos; as date))                       then inv_quantity_on_hand                        else 8 end) as inv_after8             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-15&apos; as date))                       then inv_quantity_on_hand                        else 9 end) as inv_after9             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-16&apos; as date))                       then inv_quantity_on_hand                        else 10 end) as inv_after10             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-17&apos; as date))                       then inv_quantity_on_hand                        else 11 end) as inv_after11             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-18&apos; as date))                       then inv_quantity_on_hand                        else 12 end) as inv_after12             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-19&apos; as date))                       then inv_quantity_on_hand                        else 13 end) as inv_after13             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-20&apos; as date))                       then inv_quantity_on_hand                        else 14 end) as inv_after14             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-21&apos; as date))                       then inv_quantity_on_hand                        else 15 end) as inv_after15             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-22&apos; as date))                       then inv_quantity_on_hand                        else 16 end) as inv_after16             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-23&apos; as date))                       then inv_quantity_on_hand                        else 17 end) as inv_after17             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-24&apos; as date))                       then inv_quantity_on_hand                        else 18 end) as inv_after18             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-25&apos; as date))                       then inv_quantity_on_hand                        else 19 end) as inv_after19             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-26&apos; as date))                       then inv_quantity_on_hand                        else 20 end) as inv_after20    from trino_db_text.inventory        ,trino_db_text.warehouse        ,trino_db_text.item        ,trino_db_text.date_dim    where i_current_price between 0.99 and 1.49      and item.i_item_sk          = inventory.inv_item_sk      and inventory.inv_warehouse_sk   = warehouse.w_warehouse_sk      and inventory.inv_date_sk    = date_dim.d_date_sk      and d_date between &apos;1998-03-09&apos; and &apos;1998-05-07&apos;    group by w_warehouse_name, i_item_id    ) x  where (case when inv_before &gt; 0               then inv_after / inv_before               else null              end) between 2.0/3.0 and 3.0/2.0  order by w_warehouse_name          ,i_item_id  limit 100;</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
