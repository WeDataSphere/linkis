) as inv_after10             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-17&apos; as date))                       then inv_quantity_on_hand                        else 0 end) as inv_after11             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-18&apos; as date))                       then inv_quantity_on_hand                        else 0 end) as inv_after12             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-19&apos; as date))                       then inv_quantity_on_hand                        else 0 end) as inv_after13             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-20&apos; as date))                       then inv_quantity_on_hand                        else 0 end) as inv_after14             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-21&apos; as date))                       then inv_quantity_on_hand                        else 0 end) as inv_after15             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-22&apos; as date))                       then inv_quantity_on_hand                        else 0 end) as inv_after16             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-23&apos; as date))                       then inv_quantity_on_hand                        else 0 end) as inv_after17             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-24&apos; as date))                       then inv_quantity_on_hand                        else 0 end) as inv_after18             ,sum(case when (cast(d_date as date) &gt;= cast (&apos;1998-04-25&apos; as date))                       then inv_quantity_on_hand                        else 0 end) as inv_after19    from trino_db_text.inventory        ,trino_db_text.warehouse        ,trino_db_text.item        ,trino_db_text.date_dim    where i_current_price between 0.99 and 1.49      and item.i_item_sk          = inventory.inv_item_sk      and inventory.inv_warehouse_sk   = warehouse.w_warehouse_sk      and inventory.inv_date_sk    = date_dim.d_date_sk      and d_date between &apos;1998-03-09&apos; and &apos;1998-05-07&apos;    group by w_warehouse_name, i_item_id    ) x  where (case when inv_before &gt; 0               then inv_after / inv_before               else null              end) between 2.0/3.0 and 3.0/2.0  order by w_warehouse_name          ,i_item_id  limit 100;</stringProp>
