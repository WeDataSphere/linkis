              <elementProp name="code" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">select avg(ss_list_price) B0_LP             ,COUNT(distinct ss_list_price) B1_CNTD             ,count(DISTINCT ss_list_price) B2_CNTD             ,COUNT(DISTINCT ss_list_price) B3_CNTD             ,count(distinct(ss_list_price)) B4_CNTD             ,count(distinct ss_list_price) B5_CNTD             ,count(distinct ss_list_price) B6_CNTD             ,count(distinct ss_list_price) B7_CNTD             ,count(distinct ss_list_price) B8_CNTD             ,count(distinct ss_list_price) B9_CNTD             ,count(distinct ss_list_price) B10_CNTD             ,count(distinct ss_list_price) B11_CNTD             ,count(distinct ss_list_price) B12_CNTD             ,count(distinct ss_list_price) B13_CNTD             ,count(distinct ss_list_price) B14_CNTD             ,count(distinct ss_list_price) B15_CNTD             ,count(distinct ss_list_price) B16_CNTD             ,count(distinct ss_list_price) B17_CNTD             ,count(distinct ss_list_price) B18_CNTD             ,count(distinct ss_list_price) B19_CNTD             ,count(distinct ss_list_price) B20_CNTD       from trino_db_text.store_sales       where ss_quantity between 0 and 5         and (ss_list_price between 11 and 11+10               or ss_coupon_amt between 460 and 460+1000              or ss_wholesale_cost between 14 and 14+20) ;</stringProp>
