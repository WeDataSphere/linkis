,0.0) AS sales_amt       FROM trino_db_text.web_sales JOIN trino_db_text.item ON i_item_sk=ws_item_sk                      JOIN trino_db_text.customer ON web_sales.ws_bill_customer_sk = customer.c_customer_sk                      JOIN trino_db_text.date_dim ON d_date_sk=ws_sold_date_sk                      LEFT JOIN trino_db_text.web_returns ON (ws_order_number=wr_order_number                                             AND ws_item_sk=wr_item_sk)       WHERE i_category=&apos;Sports&apos;) sales_detail GROUP BY d_year, i_brand_id, i_class_id, i_category_id, i_manufact_id;</stringProp>
