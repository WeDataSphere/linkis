        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="scriptis--hive case when超过20检测[code-precheck]--with as&gt;=20，不提示" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="code" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">with ss as  (select ca_county,d_qoy, d_year,sum(ss_ext_sales_price) as store_sales  from trino_db_text.store_sales,trino_db_text.date_dim,trino_db_text.customer_address  where ss_sold_date_sk = d_date_sk   and ss_addr_sk=ca_address_sk  group by ca_county,d_qoy, d_year),  ws as  (select ca_county,d_qoy, d_year,sum(ws_ext_sales_price) as web_sales  from trino_db_text.web_sales,trino_db_text.date_dim,trino_db_text.customer_address  where ws_sold_date_sk = d_date_sk   and ws_bill_addr_sk=ca_address_sk  group by ca_county,d_qoy, d_year)  select         ss1.ca_county        ,ss1.d_year        ,ws2.web_sales/ws1.web_sales web_q1_q2_increase        ,ss2.store_sales/ss1.store_sales store_q1_q2_increase        ,ws3.web_sales/ws2.web_sales web_q2_q3_increase        ,ss3.store_sales/ss2.store_sales store_q2_q3_increase  from         ss ss1        ,ss ss2        ,ss ss3        ,ss ss4        ,ss ss5        ,ss ss6        ,ss ss7        ,ss ss8        ,ss ss9        ,ss ss10        ,ws ws1        ,ws ws2        ,ws ws3        ,ws ws4        ,ws ws5        ,ws ws6        ,ws ws7        ,ws ws8        ,ws ws9        ,ws ws10  where     ss1.d_qoy = 1     and ss1.d_year = 1998     and ss1.ca_county = ss2.ca_county     and ss2.d_qoy = 2     and ss2.d_year = 1998  and ss2.ca_county = ss3.ca_county     and ss3.d_qoy = 3     and ss3.d_year = 1998     and ss1.ca_county = ws1.ca_county     and ws1.d_qoy = 1     and ws1.d_year = 1998     and ws1.ca_county = ws2.ca_county     and ws2.d_qoy = 2     and ws2.d_year = 1998     and ws1.ca_county = ws3.ca_county     and ws3.d_qoy = 3     and ws3.d_year =1998     and case when  ws1.web_sales &gt; 0 then ws2.web_sales/ws1.web_sales else null end         &gt; case when  ss1.store_sales &gt; 0 then ss2.store_sales/ss1.store_sales else null end     and case when ws2.web_sales &gt; 0 then ws3.web_sales/ws2.web_sales else null end        &gt; case when ss2.store_sales &gt; 0 then ss3.store_sales/ss2.store_sales else null end     and case when  ws3.web_sales &gt; 0 then ws3.web_sales/ws1.web_sales else null end         &gt; case when  ss3.store_sales &gt; 0 then ss3.store_sales/ss1.store_sales else null end     and case when ws4.web_sales &gt; 0 then ws4.web_sales/ws2.web_sales else null end        &gt; case when ss4.store_sales &gt; 0 then ss4.store_sales/ss2.store_sales else null end     and case when  ws5.web_sales &gt; 0 then ws5.web_sales/ws1.web_sales else null end         &gt; case when  ss5.store_sales &gt; 0 then ss5.store_sales/ss1.store_sales else null end     and case when ws6.web_sales &gt; 0 then ws6.web_sales/ws2.web_sales else null end        &gt; case when ss6.store_sales &gt; 0 then ss6.store_sales/ss2.store_sales else null end     and case when  ws7.web_sales &gt; 0 then ws7.web_sales/ws1.web_sales else null end         &gt; case when  ss7.store_sales &gt; 0 then ss7.store_sales/ss1.store_sales else null end     and case when ws8.web_sales &gt; 0 then ws8.web_sales/ws2.web_sales else null end        &gt; case when ss8.store_sales &gt; 0 then ss8.store_sales/ss2.store_sales else null end     and case when  ws9.web_sales &gt; 0 then ws9.web_sales/ws1.web_sales else null end         &gt; case when  ss9.store_sales &gt; 0 then ss9.store_sales/ss1.store_sales else null end     and case when ws10.web_sales &gt; 0 then ws10.web_sales/ws2.web_sales else null end        &gt; case when ss10.store_sales &gt; 0 then ss10.store_sales/ss2.store_sales else null end  order by web_q1_q2_increase;</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">code</stringProp>
              </elementProp>
