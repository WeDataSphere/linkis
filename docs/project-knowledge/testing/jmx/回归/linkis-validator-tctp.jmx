        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="scriptis--hive子查询嵌套超过3层检测[code-precheck]--子查询嵌套&gt;3层，检测成功" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="code" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">select      s_store_name,     i_item_desc,     sc.revenue,     i_current_price,     i_wholesale_cost,     i_brand from     trino_db_text.store,     trino_db_text.item,     (select          ss_store_sk, avg(revenue) as ave     from         (select          ss_store_sk, ss_item_sk, sum(ss_sales_price) as revenue     from         trino_db_text.store_sales, trino_db_text.date_dim     where         ss_sold_date_sk = d_date_sk             and d_month_seq in (select 1193 from trino_db_text.date_dim limit 1)     group by ss_store_sk , ss_item_sk) sa     group by ss_store_sk) sb,     (select          ss_store_sk, ss_item_sk, sum(ss_sales_price) as revenue     from         trino_db_text.store_sales, trino_db_text.date_dim     where         ss_sold_date_sk = d_date_sk             and d_month_seq between 1212 and 1212 + 11     group by ss_store_sk , ss_item_sk) sc where     sb.ss_store_sk = sc.ss_store_sk         and sc.revenue &lt;= 0.1 * sb.ave         and s_store_sk = sc.ss_store_sk         and i_item_sk = sc.ss_item_sk order by s_store_name , i_item_desc limit 100;</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">code</stringProp>
              </elementProp>
              <elementProp name="engineType" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">hive</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
