                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;executeApplicationName&quot;:&quot;python&quot;,&quot;executionCode&quot;:&quot;import matplotlib as mpl\nimport numpy as np\nimport matplotlib.pyplot as plt\n\nplt.figure(1)\nplt.figure(2)\nax1 = plt.subplot(211)\nax2 = plt.subplot(212)\nax1.set_title(U\&quot;test\&quot;)\nx = np.linspace(0, 3, 100)\nfor i in xrange(5):  # python2\n    plt.figure(1)\n    plt.plot(x, np.exp(i*x/3))\n    plt.sca(ax1)\n    plt.plot(x, np.sin(i*x))\n    plt.sca(ax2)\n    plt.plot(x, np.cos(i*x))\n\nshow.show_matplotlib(plt)\nplt.show()\n&quot;,&quot;runType&quot;:&quot;python&quot;,&quot;params&quot;:{&quot;variable&quot;:{},&quot;configuration&quot;:{}},&quot;labels&quot;: {&quot;executeOnce&quot;:&quot;true&quot;},&quot;source&quot;:{&quot;scriptPath&quot;:&quot;auto_test_pltshow.python2&quot;}}</stringProp>
