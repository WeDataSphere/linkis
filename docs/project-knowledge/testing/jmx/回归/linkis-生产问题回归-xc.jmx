	&quot;executionCode&quot;: &quot;select\n  &apos;${run_date}&apos; as run_date,                                 --默认获取前一天日期，支持自定义\n  &apos;${run_today}&apos; as run_today,                               --run_today=run_date+1\n  &apos;${run_today_std}&apos; as run_today_std,                       \n  &apos;${run_today_h}&apos; as run_today_h,                           --基于run_date计算，自定义优先级更高\n  &apos;${run_today_h_std}&apos; as run_today_h_std,                   --基于run_today_h计算，格式yyyy-MM-dd HH\n  &apos;${run_today_hour}&apos; as run_today_hour,                     --基于run_today计算，格式yyyyMMddHH\n  &apos;${run_today_hour_std+1}&apos; as run_today_hour_std_add1,             --基于run_today_hour计算，格式yyyy-MM-dd HH\n  &apos;${run_month_begin_std}&apos; as run_month_begin_std,           --run_date所在月的月首\n  &apos;${run_month_end}&apos; as run_month_end,                       --run_date所在月的月末\n  &apos;${run_mon}&apos; as run_mon,                                   --run_date所在月份，格式yyyyMM\n  &apos;${run_mon_std}&apos; as run_mon_std,                           --格式yyyy-MM\n  &apos;${run_current_mon_now}&apos; as run_current_mon_now,           --run_today所在月，格式yyyyMM\n  &apos;${run_current_mon_now_std}&apos; as run_current_mon_now_std,   --格式yyyy-MM\n  &apos;${run_current_mon_now+12}&apos; as run_current_mon_now_add12,\n  &apos;${run_month_now_begin_std}&apos; as run_month_now_begin_std,   --run_today所在月上一个月的月首\n  &apos;${run_month_now_end}&apos; as run_month_now_end,               --run_today所在月上一个月的月末\n  &apos;${run_month_now_end-6}&apos; as run_month_end_reduce6,\n  &apos;${run_last_mon_now}&apos; as run_last_mon_now,                 --run_today所在月的上个月\n  &apos;${run_last_mon_now_std}&apos; as run_last_mon_now_std,\n  &apos;${run_last_mon_now_std-12}&apos; as run_last_mon_now_std_sub12,\n  &apos;${run_year_begin}&apos; as run_year_begin,                     --run_date所在年的年首\n  &apos;${run_year_end_std}&apos; as run_year_end_std,                 --run_date所在年的年末\n  &apos;${run_half_year_begin}&apos; as run_half_year_begin,           --run_date所在半年的首  \n  &apos;${run_half_year_end_std}&apos; as run_half_year_end_std,       --run_date所在半年的末\n  &apos;${run_quarter_begin}&apos; as run_quarter_begin,               --run_date所在季度的季首   \n  &apos;${run_quarter_end-2}&apos; as run_quarter_end_sub2,            --run_date所在季度的季末   \n  &apos;&amp;{yyyyMMdd HHmmss}&apos; as YMDHms1,                           --基于run_date计算 \n  &apos;&amp;{yyyy-MM--dd HH%+24H}&apos; as YMDH_add_24H,\n  &apos;${f*0.2}&apos; as f,\n  &apos;${auto_globalpara}&apos; as globalpara;\n&quot;,&#xd;
