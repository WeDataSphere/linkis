        <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="根据run_date计算run_mon_true&amp;run_year_true" enabled="true">
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="script">//获取变量a的值，并赋值给b
String b = vars.get(&quot;run_date&quot;);
//将b转为浮点型，赋值给c
Float c = Float.parseFloat(b);
//将c转为整型，赋值
int e = (int)c/100;
int f = (int)e/100;
//将d转换为字符串，并赋值给e，将e的值输出
vars.put(&quot;run_mon_true&quot;,e.toString());
vars.put(&quot;run_year_true&quot;,f.toString());</stringProp>
        </BeanShellPostProcessor>
        <hashTree/>
