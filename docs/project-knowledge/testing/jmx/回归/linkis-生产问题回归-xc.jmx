            <stringProp name="Argument.desc">创建工作空间的目录名</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="filename_bug1" elementType="Argument">
            <stringProp name="Argument.name">filename_bug1</stringProp>
            <stringProp name="Argument.value">file_bug_Auto${__Random(1,499,)}.py</stringProp>
            <stringProp name="Argument.desc">方法函数脚本名称</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="udfName_bug1" elementType="Argument">
            <stringProp name="Argument.name">udfName_bug1</stringProp>
            <stringProp name="Argument.value">fun_kill_Auto</stringProp>
            <stringProp name="Argument.desc">函数名称--修改名称时scriptcontent_bug1需一并修改！！</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scriptcontent_bug1" elementType="Argument">
            <stringProp name="Argument.name">scriptcontent_bug1</stringProp>
            <stringProp name="Argument.value">def fun_kill_Auto(x):\n    factors = [1]\n    s = x\n    while x &gt; 1:\n        for v in range(2, x + 1):\n            if x % v == 0:\n                factors.append(v)\n                x //= v\n                break\n    print(\&quot;所有因子是 %s,所以\&quot; %(factors))\n    if sum(factors) == s:\n        print(\&quot;%d 是完数\&quot; %(s))\n    else:\n        print(\&quot;%d 不是完数\&quot; %(s))\n</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">方法函数脚本内容</stringProp>
          </elementProp>
          <elementProp name="fun_dirname" elementType="Argument">
            <stringProp name="Argument.name">fun_dirname</stringProp>
            <stringProp name="Argument.value">fun自动化测试</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ds" elementType="Argument">
            <stringProp name="Argument.name">ds</stringProp>
            <stringProp name="Argument.value">20220505</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">必填，如如不设置该变量，需禁用《run_date&amp;run_today&amp;run_mon-全局变量-局部变量验证》</stringProp>
          </elementProp>
          <elementProp name="colNumber" elementType="Argument">
            <stringProp name="Argument.name">colNumber</stringProp>
            <stringProp name="Argument.value">19</stringProp>
            <stringProp name="Argument.desc">global_test_db.global_test_table表字段数</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="f" elementType="Argument">
            <stringProp name="Argument.name">f</stringProp>
            <stringProp name="Argument.value">1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="file_path" elementType="Argument">
            <stringProp name="Argument.name">file_path</stringProp>
            <stringProp name="Argument.value">${__P(file_path,)}/scriptis/</stringProp>
            <stringProp name="Argument.desc">上述四个文件的存储路径</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
