          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="响应断言" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="1240789364">select\n  cluster_name,\n  &apos;存储使用日增量（GB）&apos; as key,\n  &apos;es.node.capacity.daily.inc&apos; as item,\n  cast(value / 1024 / 1024 / 1024 as string) as value\nfrom\n  xiejiandb.dws_zbx_daily_statistics\nwhere\n  key = &apos;es.cluster.capacity.increase&apos;\n  and ds = &apos;2023-04-17&apos;\nunion all\nselect\n  aa.cluster_name,\n  &apos;存储日增长率&apos; as key,\n  &apos;es.node.capacity.daily.inc.percent&apos; as item,\n  concat(round(aa.inc / bb.total, 4) * 100, &apos;%&apos;) as value\nfrom\n  (\n    select\n      cluster_name,\n      value as inc\n    from\n      xiejiandb.dws_zbx_daily_statistics\n    where\n      key = &apos;es.cluster.capacity.increase&apos;\n      and ds = &apos;2023-04-17&apos;\n  ) aa\n  join (\n    select\n      cluster_name,\n      value as total\n    from\n      xiejiandb.dws_zbx_daily_statistics\n    where\n      key = &apos;es.cluster.capacity.total&apos;\n      and ds = &apos;2023-04-17&apos;\n  ) bb on aa.cluster_name = bb.cluster_name\nunion all\nselect\n  aa.cluster_name,\n  &apos;最近存储正增长三十天日增量均值(GB)&apos; as key,\n  &apos;es.node.capacity.d30.inc.average&apos; as item,\n  cast(\n    case\n      when bb.total_count == 0 then 0\n      else aa.total_inc / bb.total_count\n    end as string\n  ) as value\nfrom\n  (\n    select\n      cluster_name,\n      sum(value) as total_inc,\n      ds\n    from\n      xiejiandb.dws_zbx_daily_statistics\n    where\n      key = &apos;es.cluster.capacity.increase&apos;\n      and value &gt;= 0\n    group by\n      cluster_name,\n      ds\n    order by\n      ds desc\n    limit\n      30\n  ) aa\n  join (\n    select\n      cluster_name,\n      count(1) as total_count,\n      ds\n    from\n      xiejiandb.dws_zbx_daily_statistics\n    where\n      key = &apos;es.cluster.capacity.increase&apos;\n      and value &gt;= 0\n    group by\n      cluster_name,\n      ds\n    order by\n      ds desc\n    limit\n      30\n  ) bb on aa.cluster_name = bb.cluster_name\nunion all\nselect\n  aa.cluster_name,\n  &apos;预测日增长量（GB）&apos; as key,\n  &apos;es.node.capacity.daily.inc.estimate&apos; as item,\n  cast(\n    case\n      when bb.total_count == 0 then 0\n      else aa.total_inc / bb.total_count\n    end as string\n  ) as value\nfrom\n  (\n    select\n      cluster_name,\n      sum(value) as total_inc,\n      ds\n    from\n      xiejiandb.dws_zbx_daily_statistics\n    where\n      key = &apos;es.cluster.capacity.increase&apos;\n      and value &gt;= 0\n    group by\n      cluster_name,\n      ds\n    order by\n      ds desc\n  ) aa\n  join (\n    select\n      cluster_name,\n      count(1) as total_count,\n      ds\n    from\n      xiejiandb.dws_zbx_daily_statistics\n    where\n      key = &apos;es.cluster.capacity.increase&apos;\n      and value &gt;= 0\n    group by\n      cluster_name,\n      ds\n    order by\n      ds desc\n  ) bb on aa.cluster_name = bb.cluster_name\nunion all\nselect\n  cc.cluster_name,\n  &apos;预计可支撑天数（超80%线，预测日增量为0，该值为9999）&apos; as key,\n  &apos;es.node.capacity.daily.available&apos; as item,\n  case\n    when cc.predict_inc == 0 then &apos;9999&apos;\n    else cast(\n      round(dd.total_of_day * 0.8 / cc.predict_inc, 2) as string\n    )\n  end as value\nfrom\n  (\n    select\n      aa.cluster_name as cluster_name,\n      case\n        when bb.total_count == 0 then 0\n        else aa.total_inc / bb.total_count\n      end as predict_inc\n    from\n      (\n        select\n          cluster_name,\n          sum(value) as total_inc,\n          ds\n        from\n          xiejiandb.dws_zbx_daily_statistics\n        where\n          key = &apos;es.cluster.capacity.increase&apos;\n          and value &gt;= 0\n        group by\n          cluster_name,\n          ds\n        order by\n          ds desc\n      ) aa\n      join (\n        select\n          cluster_name,\n          count(1) as total_count,\n          ds\n        from\n          xiejiandb.dws_zbx_daily_statistics\n        where\n          key = &apos;es.cluster.capacity.increase&apos;\n          and value &gt;= 0\n        group by\n          cluster_name,\n          ds\n        order by\n          ds desc\n      ) bb on aa.cluster_name = bb.cluster_name\n  ) cc\n  join (\n    select\n      cluster_name,\n      value as total_of_day\n    from\n      xiejiandb.dws_zbx_daily_statistics\n    where\n      key = &apos;es.cluster.capacity.total&apos;\n      and ds = &apos;2023-04-17&apos;\n  ) dd on cc.cluster_name = dd.cluster_name\nunion all\nselect\n  cluster_name,\n  &apos;当日tps峰值&apos; as key,\n  &apos;es.tps.daily.maximum&apos; as item,\n  cast(max(value) as string) as value\nfrom\n  xiejiandb.dws_zbx_daily_statistics\nwhere\n  key = &apos;es.tps.daily.max&apos;\n  and ds = &apos;2023-04-17&apos;\ngroup by\n  cluster_name\nunion all\nselect\n  aa.cluster_name as cluster_name,\n  &apos;七天内tps均值&apos; as key,\n  &apos;es.tps.d7.average&apos; as item,\n  case\n    when bb.total_days == 0 then &apos;0&apos;\n    else cast(round(total_sum / total_days) as string)\n  end as value\nfrom\n  (\n    (\n      select\n        cluster_name,\n        sum(daily_total_sum) as total_sum\n      from\n        (\n          select\n            cluster_name,\n            sum(value) as daily_total_sum,\n            ds\n          from\n            xiejiandb.dws_zbx_daily_statistics\n          where\n            key = &apos;es.tps.daily.average&apos;\n          group by\n            cluster_name,\n            ds\n          order by\n            ds desc\n          limit\n            7\n        ) a1\n      group by\n        cluster_name\n    ) aa\n    join (\n      select\n        cluster_name,\n        count(day) as total_days\n      from\n        (\n          select\n            cluster_name,\n            count(1) as day,\n            ds\n          from\n            xiejiandb.dws_zbx_daily_statistics\n          where\n            key = &apos;es.tps.daily.average&apos;\n          group by\n            cluster_name,\n            ds\n          order by\n            ds desc\n          limit\n            7\n        ) a2\n      group by\n        cluster_name\n    ) bb on aa.cluster_name = bb.cluster_name\n  )\nunion all\nselect\n  cluster_name,\n  &apos;集群理论tps峰值&apos; as key,\n  &apos;es.tps.theory.maximum&apos; as item,\n  cast(max(value) as string) as value\nfrom\n  xiejiandb.dws_zbx_daily_statistics\nwhere\n  key = &apos;es.tps.daily.max&apos;\ngroup by\n  cluster_name\nunion all\nselect\n  aa.cluster_name,\n  &apos;集群tps使用率&apos; as key,\n  &apos;es.tps.used.percent&apos; as item,\n  concat(\n    round(aa.daily_max / bb.cluster_max, 4) * 100,\n    &apos;%&apos;\n  ) as value\nfrom\n  (\n    (\n      select\n        cluster_name,\n        &apos;当日tps峰值&apos; as key,\n        max(value) as daily_max\n      from\n        xiejiandb.dws_zbx_daily_statistics\n      where\n        key = &apos;es.tps.daily.max&apos;\n        and ds = &apos;2023-04-17&apos;\n      group by\n        cluster_name\n    ) aa\n    join (\n      select\n        cluster_name,\n        &apos;集群理论tps峰值&apos; as key,\n        max(value) as cluster_max\n      from\n        xiejiandb.dws_zbx_daily_statistics\n      where\n        key = &apos;es.tps.daily.max&apos;\n      group by\n        cluster_name\n    ) bb on aa.cluster_name = bb.cluster_name\n  )\nunion all\nselect\n  cluster_name,\n  &apos;当日qps峰值&apos; as key,\n  &apos;es.qps.daily.maximum&apos; as item,\n  cast(max(value) as string) as value\nfrom\n  xiejiandb.dws_zbx_daily_statistics\nwhere\n  key = &apos;es.qps.daily.max&apos;\n  and ds = &apos;2023-04-17&apos;\ngroup by\n  cluster_name\nunion all\nselect\n  aa.cluster_name,\n  &apos;七天内qps均值&apos; as key,\n  &apos;es.qps.d7.average&apos; as item,\n  case\n    when bb.total_days == 0 then &apos;0&apos;\n    else cast(round(total_sum / total_days) as string)\n  end as value\nfrom\n  (\n    (\n      select\n        cluster_name,\n        sum(daily_total_sum) as total_sum\n      from\n        (\n          select\n            cluster_name,\n            sum(value) as daily_total_sum,\n            ds\n          from\n            xiejiandb.dws_zbx_daily_statistics\n          where\n            key = &apos;es.qps.daily.average&apos;\n          group by\n            cluster_name,\n            ds\n          order by\n            ds desc\n          limit\n            7\n        ) a1\n      group by\n        cluster_name\n    ) aa\n    join (\n      select\n        cluster_name,\n        count(day) as total_days\n      from\n        (\n          select\n            cluster_name,\n            count(1) as day,\n            ds\n          from\n            xiejiandb.dws_zbx_daily_statistics\n          where\n            key = &apos;es.qps.daily.average&apos;\n          group by\n            cluster_name,\n            ds\n          order by\n            ds desc\n          limit\n            7\n        ) a2\n      group by\n        cluster_name\n    ) bb on aa.cluster_name = bb.cluster_name\n  )\nunion all\nselect\n  cluster_name,\n  &apos;集群理论qps峰值&apos; as key,\n  &apos;es.qps.theory.maximum&apos; as item,\n  cast(max(value) as string) as value\nfrom\n  xiejiandb.dws_zbx_daily_statistics\nwhere\n  key = &apos;es.qps.daily.max&apos;\ngroup by\n  cluster_name\nunion all\nselect\n  aa.cluster_name,\n  &apos;集群qps使用率&apos; as key,\n  &apos;es.qps.used.percent&apos; as item,\n  concat(\n    round(aa.daily_max / bb.cluster_max, 4) * 100,\n    &apos;%&apos;\n  ) as value\nfrom\n  (\n    (\n      select\n        cluster_name,\n        &apos;当日qps峰值&apos; as key,\n        max(value) as daily_max\n      from\n        xiejiandb.dws_zbx_daily_statistics\n      where\n        key = &apos;es.qps.daily.max&apos;\n        and ds = &apos;2023-04-17&apos;\n      group by\n        cluster_name\n    ) aa\n    join (\n      select\n        cluster_name,\n        &apos;集群理论qps峰值&apos; as key,\n        max(value) as cluster_max\n      from\n        xiejiandb.dws_zbx_daily_statistics\n      where\n        key = &apos;es.qps.daily.max&apos;\n      group by\n        cluster_name\n    ) bb on aa.cluster_name = bb.cluster_name\n  )\nunion all\nselect\n  cluster_name,\n  &apos;当日http峰值&apos; as key,\n  &apos;es.http.daily.maximum&apos; as item,\n  cast(max(value) as string) as value\nfrom\n  xiejiandb.dws_zbx_daily_statistics\nwhere\n  key = &apos;es.http.daily.max&apos;\n  and ds = &apos;2023-04-17&apos;\ngroup by\n  cluster_name\nunion all\nselect\n  aa.cluster_name,\n  &apos;七天内http均值&apos; as key,\n  &apos;es.http.d7.average&apos; as item,\n  case\n    when bb.total_days == 0 then &apos;0&apos;\n    else cast(round(total_sum / total_days) as string)\n  end as value\nfrom\n  (\n    (\n      select\n        cluster_name,\n        sum(daily_total_sum) as total_sum\n      from\n        (\n          select\n            cluster_name,\n            sum(value) as daily_total_sum,\n            ds\n          from\n            xiejiandb.dws_zbx_daily_statistics\n          where\n            key = &apos;es.http.daily.average&apos;\n          group by\n            cluster_name,\n            ds\n          order by\n            ds desc\n          limit\n            7\n        ) a1\n      group by\n        cluster_name\n    ) aa\n    join (\n      select\n        cluster_name,\n        count(day) as total_days\n      from\n        (\n          select\n            cluster_name,\n            count(1) as day,\n            ds\n          from\n            xiejiandb.dws_zbx_daily_statistics\n          where\n            key = &apos;es.http.daily.average&apos;\n          group by\n            cluster_name,\n            ds\n          order by\n            ds desc\n          limit\n            7\n        ) a2\n      group by\n        cluster_name\n    ) bb on aa.cluster_name = bb.cluster_name\n  )\nunion all\nselect\n  cluster_name,\n  &apos;集群理论http峰值&apos; as key,\n  &apos;es.http.theory.maximum&apos; as item,\n  cast(max(value) as string) as value\nfrom\n  xiejiandb.dws_zbx_daily_statistics\nwhere\n  key = &apos;es.http.daily.max&apos;\ngroup by\n  cluster_name\nunion all\nselect\n  aa.cluster_name,\n  &apos;集群http使用率&apos; as key,\n  &apos;es.http.used.percent&apos; as item,\n  concat(\n    round(aa.daily_max / bb.cluster_max, 4) * 100,\n    &apos;%&apos;\n  ) as value\nfrom\n  (\n    (\n      select\n        cluster_name,\n        &apos;当日http峰值&apos; as key,\n        max(value) as daily_max\n      from\n        xiejiandb.dws_zbx_daily_statistics\n      where\n        key = &apos;es.http.daily.max&apos;\n        and ds = &apos;2023-04-17&apos;\n      group by\n        cluster_name\n    ) aa\n    join (\n      select\n        cluster_name,\n        &apos;集群理论http峰值&apos; as key,\n        max(value) as cluster_max\n      from\n        xiejiandb.dws_zbx_daily_statistics\n      where\n        key = &apos;es.http.daily.max&apos;\n      group by\n        cluster_name\n    ) bb on aa.cluster_name = bb.cluster_name\n</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">${__groovy(prev.getResponseDataAsString(),)}</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
