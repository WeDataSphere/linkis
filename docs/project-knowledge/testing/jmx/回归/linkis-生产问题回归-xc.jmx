	&quot;executeApplicationName&quot;: &quot;spark&quot;,&#xd;
	&quot;executionCode&quot;: &quot;select\n&apos;${run_date}&apos; as run_date,\n&apos;${submit_user}&apos; as submit_user,\n&apos;${execute_user}&apos;as execute_user; \n&quot;,&#xd;
	&quot;runType&quot;: &quot;sql&quot;,&#xd;
	&quot;params&quot;: {&#xd;
		&quot;variable&quot;: {&#xd;
			&quot;submit_user&quot;: &quot;allenlliu&quot;,&#xd;
			&quot;execute_user&quot;: &quot;alexyang&quot;&#xd;
		},&#xd;
		&quot;configuration&quot;: {}&#xd;
	},&#xd;
	&quot;source&quot;: {&#xd;
		&quot;scriptPath&quot;: &quot;autotest&quot;&#xd;
	}&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
