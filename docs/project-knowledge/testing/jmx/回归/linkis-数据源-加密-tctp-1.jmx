          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="提交spark任务--创建多级分级表并插入数据/创建非分区表" enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
	&quot;executeApplicationName&quot;: &quot;spark&quot;,&#xd;
	&quot;executionCode&quot;: &quot;---多级分区表\ncreate table if not exists ${database_hive}.table_many_partitions\n(\nerr_id          int\n,err_source          string\n,act_id          string\n,data          string\n)\nCOMMENT &apos;多级分区测试&apos;\nPARTITIONED BY (month STRING comment \&quot;按月的分区表字段\&quot;,day string comment \&quot;按天的分区表字段\&quot;)\nROW FORMAT DELIMITED\nFIELDS TERMINATED BY &apos;\\001&apos;\nLINES TERMINATED BY &apos;\\n&apos;\nSTORED AS TEXTFILE;\n\ninsert into table ${database_hive}.table_many_partitions PARTITION ( month=&apos;${run_mon}&apos;,day=&apos;${run_date}&apos;) select 1,\&quot;a\&quot;,\&quot;b\&quot;,\&quot;c\&quot;;\n\n-----查询建表，只会复制列和属性值，不会复制分区及约束\nCREATE TABLE if not exists ${database_hive}.table_no_partitions AS \n    SELECT *\n    FROM ${database_hive}.table_many_partitions\n    where month=${run_mon}/day=${run_date};\n&quot;,&#xd;
	&quot;runType&quot;: &quot;sql&quot;,&#xd;
	&quot;params&quot;: {&#xd;
		&quot;variable&quot;: {},&#xd;
		&quot;configuration&quot;: {}&#xd;
	},&#xd;
	&quot;source&quot;: {&#xd;
		&quot;scriptPath&quot;: &quot;初始化数据-新建多级分区库表.sql&quot;&#xd;
	}&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.domain"></stringProp>
            <stringProp name="HTTPSampler.port"></stringProp>
            <stringProp name="HTTPSampler.protocol"></stringProp>
            <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
            <stringProp name="HTTPSampler.path">/api/rest_j/v1/entrance/execute</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
