          </elementProp>
          <elementProp name="filename5" elementType="Argument">
            <stringProp name="Argument.name">filename5</stringProp>
            <stringProp name="Argument.value">file_fun_Auto${__Random(1,499,)}.scala</stringProp>
            <stringProp name="Argument.desc">scala类型脚本名称</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scriptcontent5" elementType="Argument">
            <stringProp name="Argument.name">scriptcontent5</stringProp>
            <stringProp name="Argument.value">def fun_scala_Auto(a:Int, b:Int): Int = a+b+2</stringProp>
            <stringProp name="Argument.desc">def函数名需与udfName5一致！！！！！！！</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="filename6" elementType="Argument">
            <stringProp name="Argument.name">filename6</stringProp>
            <stringProp name="Argument.value">many_udf${__Random(1,499,)}.py</stringProp>
            <stringProp name="Argument.desc">py类型脚本名称</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scriptcontent6" elementType="Argument">
            <stringProp name="Argument.name">scriptcontent6</stringProp>
            <stringProp name="Argument.value">def autoadd(a, b):\n    return a + b + 10;\ndef fun_py_Auto(str):\n    return \&quot;hello,funtion--\&quot; + str\ndef deal_array(list1, list2, list3, list4):\n    if all(isinstance(x, str) for x in list1):\n        list1 = list(map(int, list1))\n    if all(isinstance(x, str) for x in list2):\n        list2 = list(map(int, list2))\n    if all(isinstance(x, str) for x in list3):\n        list3 = list(map(int, list3))\n    if all(isinstance(x, str) for x in list4):\n        list4 = list(map(int, list4))\n    print(map(lambda x, y,z,w:x+y+z+w, list1, list2, list3, list4))\n    return list(map(lambda x,y,z,w:x+y+z+w, list1, list2, list3, list4))\n</stringProp>
            <stringProp name="Argument.desc">在脚本中输入的内容，与楼上文件类型参数匹配</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="filename7" elementType="Argument">
            <stringProp name="Argument.name">filename7</stringProp>
            <stringProp name="Argument.value">complex_class_udf${__Random(1,499,)}.scala</stringProp>
            <stringProp name="Argument.desc">py类型脚本名称</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scriptcontent7" elementType="Argument">
            <stringProp name="Argument.name">scriptcontent7</stringProp>
            <stringProp name="Argument.value">class SimpleCalculator:\n    def add(self, a, b):\n        \&quot;\&quot;\&quot;加法函数，返回两个数的和\&quot;\&quot;\&quot;\n        return a + b\n\n    def subtract(self, a, b):\n        \&quot;\&quot;\&quot;减法函数，返回两个数的差\&quot;\&quot;\&quot;\n        return a - b\n</stringProp>
            <stringProp name="Argument.desc">在脚本中输入的内容，与楼上文件类型参数匹配</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="udfNamesys" elementType="Argument">
            <stringProp name="Argument.name">udfNamesys</stringProp>
            <stringProp name="Argument.value">wb_date_format</stringProp>
            <stringProp name="Argument.desc">------------BDAP函数------------- yyyymmdd&lt;-&gt;yyyy-mm-dd</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="newdescription" elementType="Argument">
            <stringProp name="Argument.name">newdescription</stringProp>
            <stringProp name="Argument.value">auto_test_udf_change</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">修改udf描述</stringProp>
          </elementProp>
          <elementProp name="run_date" elementType="Argument">
            <stringProp name="Argument.name">run_date</stringProp>
            <stringProp name="Argument.value">20211222</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="workspaceName" elementType="Argument">
            <stringProp name="Argument.name">workspaceName</stringProp>
            <stringProp name="Argument.value">${__P(workspaceName,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LT" elementType="Argument">
            <stringProp name="Argument.name">LT</stringProp>
            <stringProp name="Argument.value">${__P(LT,)}</stringProp>
            <stringProp name="Argument.desc">异步接口轮询时间，单位ms</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="summary_report_path" elementType="Argument">
            <stringProp name="Argument.name">summary_report_path</stringProp>
            <stringProp name="Argument.value">${__P(summary_report_path,)}/udf-report.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">配置《断言结果》报告地址</stringProp>
          </elementProp>
          <elementProp name="udfName21" elementType="Argument">
            <stringProp name="Argument.name">udfName21</stringProp>
            <stringProp name="Argument.value">udf_scala1_Auto${__Random(1,999,)}</stringProp>
            <stringProp name="Argument.desc">----------------------------------新增scala类型UDF名称------------------</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="filename21" elementType="Argument">
            <stringProp name="Argument.name">filename21</stringProp>
            <stringProp name="Argument.value">file_udf1_Auto${__Random(1,499,)}.scala</stringProp>
            <stringProp name="Argument.desc">scala-class类型脚本1名称</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scriptcontent21" elementType="Argument">
            <stringProp name="Argument.name">scriptcontent21</stringProp>
            <stringProp name="Argument.value">class StringTransformer {\n    def toUpper(s: String): String = s.toUpperCase\n}</stringProp>
            <stringProp name="Argument.desc">在脚本中输入的内容，与楼上文件类型参数匹配</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="udfName22" elementType="Argument">
            <stringProp name="Argument.name">udfName22</stringProp>
            <stringProp name="Argument.value">udf_scala2_Auto${__Random(1,999,)}</stringProp>
            <stringProp name="Argument.desc">----------------------------------新增scala类型UDF名称------------------</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="filename22" elementType="Argument">
            <stringProp name="Argument.name">filename22</stringProp>
            <stringProp name="Argument.value">file_udf2_Auto${__Random(1,499,)}.scala</stringProp>
            <stringProp name="Argument.desc">scala-class类型脚本2名称</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scriptcontent22" elementType="Argument">
            <stringProp name="Argument.name">scriptcontent22</stringProp>
            <stringProp name="Argument.value">// 定义一个字符串转换器类\nclass StringTransformer {\n    def toUpper(s: String): String = s.toUpperCase\n}\n//使用方法创建转换器并转换字符串\ndef convertToUpper(input: String): String ={\n    val transformer = new StringTransformer\n    transformer.toUpper(input)\n}</stringProp>
            <stringProp name="Argument.desc">在脚本中输入的内容，与楼上文件类型参数匹配</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="udfName8" elementType="Argument">
            <stringProp name="Argument.name">udfName8</stringProp>
            <stringProp name="Argument.value">fun_scala2_Auto${__Random(1,999,)}</stringProp>
            <stringProp name="Argument.desc">----------------------------------新增scala类型UDF名称------------------</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="filename8" elementType="Argument">
            <stringProp name="Argument.name">filename8</stringProp>
            <stringProp name="Argument.value">file_scala2_Auto${__Random(1,499,)}.scala</stringProp>
            <stringProp name="Argument.desc">scala-class类型脚本2名称</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scriptcontent8" elementType="Argument">
            <stringProp name="Argument.name">scriptcontent8</stringProp>
            <stringProp name="Argument.value">// 1、class1\nclass StringTransformer {\n    def toUpper(s: String): String = s.toUpperCase\n}\n\n\n// 2、class1\n//使用方法创建转换器并转换字符串\ndef convertToUpper(input: String): String ={\n    val transformer = new StringTransformer\n    transformer.toUpper(input)\n}\n\n// 3、class3\nimport org.apache.spark.sql.expressions.Aggregator\nimport org.apache.spark.sql.{Encoder, Encoders}\n\n// 定义聚合函数的中间状态\ncase class Average(var sum: Double, var count: Long)\n\n// 实现自定义聚合函数\nobject MyAverage extends Aggregator[Double, Average, Double] {\n  // 初始化中间状态\n  def zero: Average = Average(0.0, 0L)\n  \n  // 合并输入值到中间状态\n  def reduce(buffer: Average, data: Double): Average = {\n    buffer.sum += data\n    buffer.count += 1\n    buffer\n  }\n  \n  // 合并两个中间状态\n  def merge(b1: Average, b2: Average): Average = {\n    b1.sum += b2.sum\n    b1.count += b2.count\n    b1\n  }\n  \n  // 计算最终结果\n  def finish(reduction: Average): Double = reduction.sum / reduction.count\n  \n  // 指定中间状态的编码器\n  def bufferEncoder: Encoder[Average] = Encoders.product\n  \n  // 指定输出结果的编码器\n  def outputEncoder: Encoder[Double] = Encoders.scalaDouble\n}\n</stringProp>
            <stringProp name="Argument.desc">在脚本中输入的内容，与楼上文件类型参数匹配</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="udfName_aes" elementType="Argument">
            <stringProp name="Argument.name">udfName_aes</stringProp>
            <stringProp name="Argument.value">cibaesdecryptwithsalt1</stringProp>
            <stringProp name="Argument.desc">----------------------------------新增py类型UDF名称---------------------</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="filename_aes" elementType="Argument">
            <stringProp name="Argument.name">filename_aes</stringProp>
            <stringProp name="Argument.value">file_udf_Auto_aes.py</stringProp>
            <stringProp name="Argument.desc">py类型脚本名称</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scriptcontent_aes" elementType="Argument">
            <stringProp name="Argument.name">scriptcontent_aes</stringProp>
            <stringProp name="Argument.value">def autoadd(a, b):\n    return a + b\n</stringProp>
            <stringProp name="Argument.desc">在脚本中输入的内容，与楼上文件类型参数匹配</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
